# ─────────────────────────────────────────────────────────────────────────────
# Project FORESIGHT — environment configuration (.env.example)
# Copy to .env for docker-compose, or export for local runs.
# Defaults shown are safe for local use.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Streamlit dashboard looks for the scoring service.
FORESIGHT_API_URL=http://localhost:8000

# Optional bearer token. When set, the API REQUIRES
# `Authorization: Bearer <token>` on /predict, /summary, /evaluation, /skus.
# Leave empty for open (dev) access.
FORESIGHT_AUTH_TOKEN=

# Comma-separated CORS origins the browser may call the API from.
FORESIGHT_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Override location of processed parquet artefacts (Docker sets /app/data/processed).
FORESIGHT_DATA_DIR=

# Risk-threshold tuning (see src/risk.py).
FORESIGHT_STOCKOUT_THRESHOLD_WEEKS=2.0
FORESIGHT_OVERSTOCK_THRESHOLD_WEEKS=8.0
FORESIGHT_RISK_HIGH_THRESHOLD=0.5

# Set to 1 to force a full pipeline rebuild on next container boot.
REBUILD=0